name: 添加持仓

on:
  workflow_dispatch:
    inputs:
      code:
        description: '股票代码（如 000001）'
        required: true
      name:
        description: '股票名称（如 平安银行）'
        required: true
      price:
        description: '买入价格（如 12.50）'
        required: true

jobs:
  add:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v3

      - name: 添加持仓到 positions.json
        run: |
          python3 -c "
          import json
          with open('positions.json', 'r') as f:
              data = json.load(f)
          new_item = {
              'code': '${{ github.event.inputs.code }}',
              'name': '${{ github.event.inputs.name }}',
              'buy_price': float('${{ github.event.inputs.price }}'),
              'buy_date': '$(date +%Y-%m-%d)',
              'status': 'holding'
          }
          data.append(new_item)
          with open('positions.json', 'w') as f:
              json.dump(data, f, ensure_ascii=False, indent=2)
          print('已添加:', new_item)
          "

      - name: 提交更新
        run: |
          git config user.name "GitHub Actions"
          git config user.email "actions@github.com"
          git add positions.json
          git commit -m "添加持仓: ${{ github.event.inputs.name }}(${{ github.event.inputs.code }})"
          git push
